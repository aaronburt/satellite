<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: lets scripts/device-checks.sh change settings and
             read audio state over adb. DUMP is held by the adb shell but not by
             ordinary apps, so other apps cannot send these broadcasts. -->
        <receiver
            android:name=".devicecheck.DeviceCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
